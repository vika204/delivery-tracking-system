        {
          "name": "4. calculate delivery quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.quoteId) {",
                  "    pm.collectionVariables.set('quoteId', data.quoteId);",
                  "    pm.collectionVariables.set('idempotencyKey', 'idem-' + data.quoteId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupCityCode\": \"UA80000000000093317\",\n  \"pickupAddress\": \"Київ, вул. Іллінська, 2\",\n  \"deliveryCityCode\": \"UA80000000000093317\",\n  \"deliveryAddress\": \"Київ, Контрактова площа, 2\",\n  \"weight\": 3.5\n}"
            },
            "url": {
              "raw": "{{webUiUrl}}/api/shipments/quotes",
              "host": [
                "{{webUiUrl}}"
              ],
              "path": [
                "api",
                "shipments",
                "quotes"
              ]
            }
          }
        },
        {
          "name": "5. create shipment (transactional outbox to kafka)",
