            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('idempotent replay returns 200 and header Idempotent-Replayed=true', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
                  "});"
                ]
              }
            }
