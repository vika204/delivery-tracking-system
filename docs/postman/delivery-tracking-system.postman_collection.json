            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"senderName\": \"Olena Kovalenko\",\n  \"senderPhone\": \"+380671234567\",\n  \"recipientName\": \"Marta Boyko\",\n  \"recipientPhone\": \"+380501234569\",\n  \"length\": 30,\n  \"width\": 20,\n  \"height\": 15\n}"
            },
            "url": {
              "raw": "{{webUiUrl}}/api/shipments",
