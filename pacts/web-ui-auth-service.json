{
  "consumer": {
    "name": "web-ui"
  },
  "interactions": [
    {
      "description": "a profile read for an unknown user",
      "request": {
        "headers": {
          "X-User-Id": "999"
        },
        "method": "GET",
        "path": "/users/profile"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "a profile read for user 42",
      "providerStates": [
        {
          "name": "user 42 exists"
        }
      ],
      "request": {
        "headers": {
          "X-User-Id": "42"
        },
        "method": "GET",
        "path": "/users/profile"
      },
      "response": {
        "body": {
          "email": "olena@example.com",
          "firstName": "Olena",
          "lastName": "Kovalenko",
          "phone": "+380501234567"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.firstName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lastName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.phone": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a profile update for user 42",
      "providerStates": [
        {
          "name": "user 42 exists"
        }
      ],
      "request": {
        "body": {
          "email": "olena@example.com",
          "firstName": "Olena",
          "lastName": "Kovalenko",
          "phone": "+380501234567"
        },
        "headers": {
          "Content-Type": "application/json",
          "X-User-Id": "42"
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.firstName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lastName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.phone": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "PUT",
        "path": "/users/profile"
      },
      "response": {
        "body": {
          "email": "olena@example.com",
          "firstName": "Olena",
          "lastName": "Kovalenko",
          "phone": "+380501234567"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.firstName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lastName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.phone": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.17"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "auth-service"
  }
}
