        "eventType": "COURIER_ASSIGNED",
        "occurredAt": "2026-11-22T12:00:00Z",
        "shipmentId": 15
      },
      "description": "a COURIER_ASSIGNED event",
      "generators": {
        "body": {
          "$.eventId": {
            "type": "Uuid"
          }
        }
      },
      "matchingRules": {
        "body": {
          "$.assignmentId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.courierId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.courierName": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.eventId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.occurredAt": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z"
              }
            ]
          },
          "$.shipmentId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      }
    },
