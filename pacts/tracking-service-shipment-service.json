{
  "consumer": {
    "name": "tracking-service"
  },
  "interactions": [
    {
      "description": "a request for shipment 1",
      "providerStates": [
        {
          "name": "shipment 1 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/shipments/1"
      },
      "response": {
        "body": {
          "recipientName": "Ivan Petrenko",
          "shipmentId": 1,
          "status": "CREATED"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.recipientName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.shipmentId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.17"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "shipment-service"
  }
}