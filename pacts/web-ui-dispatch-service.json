    {
      "description": "a courier status read",
      "providerStates": [
        {
          "name": "courier 10 is online"
        }
      ],
      "request": {
        "headers": {
          "X-User-Id": "10"
        },
        "method": "GET",
        "path": "/couriers/10/status"
      },
      "response": {
        "body": {
          "activeAssignments": 0,
          "courierId": 10,
          "online": true,
          "pendingOfferId": null,
          "state": "AVAILABLE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.activeAssignments": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.courierId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.online": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.state": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "AVAILABLE|BUSY|UNAVAILABLE"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
