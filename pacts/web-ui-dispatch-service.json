    {
      "description": "an active assignments read",
      "providerStates": [
        {
          "name": "courier 10 has active assignment 3"
        }
      ],
      "request": {
        "headers": {
          "X-User-Id": "10"
        },
        "method": "GET",
        "path": "/couriers/10/assignments",
        "query": {
          "active": [
            "true"
          ]
        }
      },
      "response": {
        "body": [
          {
            "assignmentId": 3,
            "deliveryAddress": "Lviv, Svobody 10",
            "pickedUp": false,
            "pickupAddress": "Kyiv, Khreshchatyk 1",
            "shipmentId": 15,
            "status": "ACTIVE"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].assignmentId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].deliveryAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].pickedUp": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].pickupAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].shipmentId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
