apiVersion: v1
kind: Secret
metadata:
  name: shipment-db-secret
  namespace: delivery
  labels:
    app: shipment-db
type: Opaque
stringData:
  POSTGRES_USER: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: shipment-geoapify-secret
  namespace: delivery
type: Opaque
stringData:
  GEOAPIFY_API_KEY: CHANGE_ME
