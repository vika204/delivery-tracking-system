# Шаблон. Скопіюйте у secret.yml (він у .gitignore) і задайте власні значення:
#   cp k8s/shipment/secret.yml.example k8s/shipment/secret.yml
apiVersion: v1
kind: Secret
metadata:
  name: shipment-db-secret
  namespace: delivery
  labels:
    app: shipment-db
type: Opaque
stringData:
  POSTGRES_USER: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME
