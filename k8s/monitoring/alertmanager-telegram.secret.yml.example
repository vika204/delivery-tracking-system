# Template. Copy it to secret.yml (git-ignored) and set your own values:
#   cp k8s/monitoring/alertmanager-telegram.secret.yml.example k8s/monitoring/alertmanager-telegram.secret.yml
# BOT_TOKEN is issued by @BotFather, CHAT_ID is the numeric chat id (can be found via getUpdates).
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-telegram
  namespace: delivery
  labels:
    app: telegram-alert-bridge
type: Opaque
stringData:
  BOT_TOKEN: CHANGE_ME
  CHAT_ID: CHANGE_ME
